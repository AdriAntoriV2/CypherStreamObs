generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Stream {
  id        String   @id @default(uuid())
  title     String
  startedAt DateTime
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events StreamEvent[]

  @@index([startedAt])
}

model StreamEvent {
  id         String   @id @default(uuid())
  streamId   String

  externalId String?
  type       String
  payload    Json

  createdAt DateTime @default(now())

  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  executions AutomationExecution[]

  @@unique([externalId])
  @@index([streamId])
  @@index([type])
  @@index([createdAt])
}

model AutomationRule {
  id        String   @id @default(uuid())
  name      String
  enabled   Boolean  @default(true)

  eventType String

  conditions Json?
  actions    Json

  priority  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions AutomationExecution[]

  @@index([eventType])
  @@index([enabled])
}

model AutomationExecution {
  id        String   @id @default(uuid())
  ruleId    String
  eventId   String

  status    String
  attempts  Int      @default(0)
  result    Json?
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  event StreamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  actions AutomationActionExecution[]

  @@unique([ruleId, eventId])
  @@index([eventId])
  @@index([status])
}

model AutomationActionExecution {
  id          String   @id @default(uuid())
  executionId String

  actionIndex Int
  actionType String

  status      String
  result      Json?
  error       String?

  createdAt   DateTime @default(now())
  completedAt DateTime?

  execution AutomationExecution @relation( fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, actionIndex])
  @@index([executionId])
  @@index([status])
}

model TwitchAccount {
  id String @id @default(uuid())

  twitchUserId String @unique
  login String
  displayName String

  accessTokenEncrypted String
  refreshTokenEncrypted String

  accessTokenExpiresAt DateTime
  tokenVersion Int @default(1)

  scopes String[]

  connectedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([login])
}

model ChatCommand {
  id String @id @default(uuid())

  name String @unique
  enabled Boolean @default(true)

  cooldownSeconds Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}