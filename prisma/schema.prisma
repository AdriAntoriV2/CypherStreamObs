generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Stream {
  id        String   @id @default(uuid())
  title     String
  startedAt DateTime
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events StreamEvent[]

  @@index([startedAt])
}

model StreamEvent {
  id        String   @id @default(uuid())
  streamId  String

  type      String
  payload   Json

  createdAt DateTime @default(now())

  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([type])
  @@index([createdAt])
}